# Collagent backend configuration — copy to .env for docker-compose, or
# export in your process manager. Never commit real values.

# --- persistence (production: PostgreSQL is the source of truth) ---
DATABASE_URL=postgres://collagent:CHANGE_ME@localhost:5432/collagent
POSTGRES_PASSWORD=CHANGE_ME

# --- security ---
# Hosted mode: require registered users and per-room join keys for every
# non-loopback client ("1"). Local dev leaves these unset ("auto": loopback
# connections skip both).
COLLAGENT_REQUIRE_AUTH=1
COLLAGENT_REQUIRE_JOIN_KEY=1
# Behind a TLS-terminating proxy, trust X-Forwarded-For for rate limits.
COLLAGENT_TRUST_PROXY=1
# Browser origins allowed to call the HTTP API (comma-separated, or *).
COLLAGENT_CORS_ORIGINS=https://app.example.com

# --- transport ---
HOST=0.0.0.0
PORT=7717
# Native TLS (leave unset when a proxy terminates TLS in front):
# COLLAGENT_TLS_CERT=/etc/collagent/tls.crt
# COLLAGENT_TLS_KEY=/etc/collagent/tls.key

# --- operations ---
COLLAGENT_LOG_FORMAT=json
COLLAGENT_DATA_DIR=/data
# In-memory events kept per room; older history is served from the database.
COLLAGENT_EVENT_CACHE=5000
